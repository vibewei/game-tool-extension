{
  "manifest_version": 3,
  "name": "游戏测试助手（连点/网络/录屏）",
  "version": "1.8.2",
  "description": "游戏测试助手：连点、弱网/断网模拟、自动录屏回放（保存点击前 15/30/60 秒）、可配置快捷键与插件启用域名。",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "游戏助手：显示/隐藏面板（Alt+G）"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+G"
      },
      "description": "显示/隐藏游戏助手面板"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page-inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
